    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "license": "Apache-2.0",
  "bin": {
    "roster-dashboard": "./build/src/cli.js"
  }
}
